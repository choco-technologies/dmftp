# DMOD Resource File for ftpd
# This file specifies where resources should be installed

# === Core Module ===
# Main module file - always installed
dmf=./${module}.dmf => ${destination}/${module}.dmf [origin=${dmf_dir}/${module}.dmf]

# Compressed module
dmfc=./${module}.dmfc => ${destination}/${module}.dmfc [origin=${build_dir}/dmfc/${module}.dmfc]

# Dependencies file (if exists)
dmd=./${module}.dmd => ${destination}/${module}.dmd [origin=${dmf_dir}/${module}.dmd]

# Version information
version=./${module}_version.txt => ${destination}/${module}_version.txt [origin=${dmf_dir}/${module}_version.txt]

# === Documentation ===
# README file
# NOTE: ${repo_dir} is the top-level repo root (CMAKE_SOURCE_DIR), since
# ftpd is built via add_subdirectory() from libftp's own CMakeLists.txt -
# so paths here are given relative to the repo root, not to tools/ftpd
# itself (see dmtelnet/tools/telnetd/telnetd.dmr for the same pattern).
readme=./README.md => ${destination}/${module}/README.md [origin=${repo_dir}/tools/ftpd/README.md]

docs=./docs => ${destination}/${module}/docs [origin=${repo_dir}/tools/ftpd/docs]

# === Configuration Files ===
# ftpd.ini - example dmsystem unit template (exec=ftpd, type=simple,
# args=--port ... --root ... --user ... --pass ...) - see
# tools/ftpd/docs/service.md
configs=./configs => ${destination}/${module}/configs [origin=${repo_dir}/tools/ftpd/configs]

# === License ===
# License file (shared with the rest of the dmftp repository)
license=./LICENSE => ${destination}/${module}/LICENSE [origin=${repo_dir}/LICENSE]

# Adding itself
dmr=./${module}.dmr => ${destination}/${module}/${module}.dmr [origin=${repo_dir}/tools/ftpd/${module}.dmr]
